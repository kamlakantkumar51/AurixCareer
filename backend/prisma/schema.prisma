generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                   String             @id @default(uuid())
  email                String             @unique
  passwordHash         String?
  role                 String             @default("STUDENT") // STUDENT, RECRUITER, ADMIN
  isVerified           Boolean            @default(false)
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  studentProfile   StudentProfile?
  recruiterProfile RecruiterProfile?
  notifications    Notification[]
  sentMessages     Message[]          @relation("SentMessages")
  receivedMessages Message[]          @relation("ReceivedMessages")
}

model StudentProfile {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName               String?
  lastName                String?
  phone                   String?
  location                String?
  cgpa                    Float?
  graduationYear          Int?
  resumeUrl               String?  // Legacy field
  targetRole              String?
  linkedinUrl             String?
  profilePicture          String?
  universityName          String?
  summary                 String?
  careerJourney           String?
  placementReadinessScore Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  education       Education[]
  experience      Experience[]
  projects        Project[]
  skills          StudentSkill[]
  resumes         Resume[]
  applications    Application[]
  savedJobs       SavedJob[]
  submissions     Submission[]
  roadmaps        Roadmap[]
  resumeAnalyses  ResumeAnalysis[]
  assessments     AssessmentResult[]
  recruiterNotes  RecruiterNote[]
  savedByRecruiters SavedCandidate[]
}

model AssessmentResult {
  id                   String         @id @default(uuid())
  studentProfileId     String
  studentProfile       StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  assessmentId         String
  score                Int
  totalQuestions       Int
  correctAnswers       Int
  incorrectAnswers     Int
  unanswered           Int
  percentage           Float
  timeTaken            Int            // In seconds
  startedAt            DateTime
  completedAt          DateTime       @default(now())
  proctoringViolations Int            @default(0)
  violationTypes       String?        // JSON string of violations
  completionStatus     String         @default("COMPLETED") // COMPLETED, TERMINATED_PROCTORING
}

model RecruiterProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  firstName String
  lastName  String
  position  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs Job[]
  notes RecruiterNote[]
  savedCandidates SavedCandidate[]
}

model Company {
  id          String   @id @default(uuid())
  name        String
  description String?
  website     String?
  logoUrl     String?
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recruiters RecruiterProfile[]
  jobs       Job[]
}

model Education {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  college          String
  degree           String
  branch           String
  cgpa             Float?
  graduationYear   Int
}

model Experience {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  company          String
  role             String
  duration         String
  description      String?
}

model Project {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  technologies     String? 
  githubUrl        String?
  liveUrl          String?
}

model Skill {
  id       String @id @default(uuid())
  name     String @unique
  category String 

  studentSkills StudentSkill[]
  jobSkills     JobSkill[]
}

model StudentSkill {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  skillId          String
  skill            Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  proficiency      Int            @default(3) 

  @@unique([studentProfileId, skillId])
}

model Resume {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  fileUrl          String
  fileName         String
  fileSize         Int
  title            String?
  targetRole       String?
  description      String?
  isPrimary        Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  analyses ResumeAnalysis[]
}

model ResumeAnalysis {
  id               String         @id @default(uuid())
  resumeId         String
  resume           Resume         @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  atsScore         Float
  structuredData   String 
  suggestions      String 
  createdAt        DateTime       @default(now())
}

model Job {
  id               String   @id @default(uuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recruiterId      String
  recruiter        RecruiterProfile @relation(fields: [recruiterId], references: [id], onDelete: Restrict)
  title            String
  description      String
  responsibilities String?
  requirements     String?
  type             String   @default("FULL_TIME") 
  mode             String   @default("REMOTE") 
  salaryMin        Float?
  salaryMax        Float?
  experienceMin    Int?
  experienceMax    Int?
  location         String?
  status           String   @default("OPEN")
  deadline         DateTime?
  screeningQuestions String?
  autoClose        Boolean  @default(false)
  remoteAllowed    Boolean  @default(false)
  resumeRequired   Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  skills       JobSkill[]
  applications Application[]
  savedJobs    SavedJob[]
}

model JobSkill {
  id      String @id @default(uuid())
  jobId   String
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
}

model Application {
  id               String            @id @default(uuid())
  jobId            String
  job              Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  studentProfileId String
  studentProfile   StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  status           String            @default("APPLIED") 
  matchScore       Float?
  notes            String?
  appliedAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  interviews Interview[]

  @@unique([jobId, studentProfileId])
}

model SavedJob {
  id               String         @id @default(uuid())
  jobId            String
  job              Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  savedAt          DateTime       @default(now())

  @@unique([jobId, studentProfileId])
}

model SavedCandidate {
  id               String           @id @default(uuid())
  recruiterId      String
  recruiter        RecruiterProfile @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  studentProfileId String
  studentProfile   StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  notes            String?
  talentGroup      String?          
  savedAt          DateTime         @default(now())

  @@unique([recruiterId, studentProfileId])
}

model Interview {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledAt   DateTime
  status        String      @default("SCHEDULED") 
  feedback      String?
  score         Float?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Question {
  id          String   @id @default(uuid())
  title       String
  description String
  difficulty  String   
  topics      String?
  examples    String   
  constraints String   
  testCases   String   

  submissions Submission[]
}

model Submission {
  id               String         @id @default(uuid())
  questionId       String
  question         Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  code             String
  language         String
  status           String         
  createdAt        DateTime       @default(now())
}

model Roadmap {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  targetRole       String
  generatedAt      DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  items RoadmapItem[]
}

model RoadmapItem {
  id          String  @id @default(uuid())
  roadmapId   String
  roadmap     Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  week        Int
  topic       String
  description String
  status      String  @default("PENDING") 
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model RecruiterNote {
  id               String         @id @default(uuid())
  recruiterId      String
  recruiter        RecruiterProfile @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  content          String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String
  userId    String?
  details   String? 
  createdAt DateTime @default(now())
}
